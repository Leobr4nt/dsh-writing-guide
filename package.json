{
  "name": "@local/dsh-writing-guide",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "为 DeepSeek Harness 增加写作模式，在正常会话中应用预设、世界书和角色卡。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "KNOWN_ISSUES.md",
    "HANDOFF.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "ajv": "8.20.0",
    "ejs": "3.1.10",
    "esbuild": "0.25.12",
    "htmlparser2": "10.0.0",
    "ipaddr.js": "2.2.0",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.1",
    "lodash": "4.18.1",
    "marked": "17.0.1",
    "playwright-core": "1.58.2",
    "quickjs-emscripten-core": "0.32.0",
    "sanitize-html": "2.18.1",
    "vue": "3.5.45",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
